# webhook-service 配置文件
# 单实例可管理多个项目目录,复制为 config.toml 后按需修改

# Web 界面与 API 监听端口
port = "8079"
# 监听地址:留空或 0.0.0.0 = 全部地址;localhost / 127.0.0.1 = 仅本机;也可填具体 IP 如 192.168.1.10
host = ""
# Web 界面登录密码,留空则免登录(webhook 始终走 token 认证)
password = ""
# 全局 webhook token,项目未单独配置 token 时使用
token = "your-global-webhook-token"
# 日志目录(每个项目一个 <name>.log,另有 system.log)
log-dir = "logs"

# 项目列表:每个项目对应一个仓库目录
# webhook 地址:POST /webhook/<name>
[[projects]]
name = "web"
path = "/srv/apps/web"
branch = "main"
script = "build"
package-manager = "pnpm"
dist = "./dist"
output = "/usr/local/var/www/web"
token = ""
additional-script = ""
additional-script-args = []

[[projects]]
name = "admin"
path = "/srv/apps/admin"
branch = ""
script = "build:prod"
package-manager = "npm"
dist = "./dist"
output = "/usr/local/var/www/admin"
token = ""
additional-script = ""
additional-script-args = []
